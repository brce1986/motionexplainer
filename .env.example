# Copy to .env (never commit .env). Scripts read these; values are never printed.

# Primary voice (Azure Speech HD neural voices) + transcription check
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Fallback voice (Gemini TTS)
GEMINI_API_KEY=

# Optional: free stock photos to fill gaps (https://www.pexels.com/api/ , https://pixabay.com/api/docs/)
PEXELS_API_KEY=
PIXABAY_API_KEY=
